AGENT_MODEL_PROVIDER=openai
AGENT_MODEL=gpt-4o
VERIFIER_MODEL=gpt-4o
VISION_MODEL=gpt-4o
EVALUATION_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
AGENT_SIMULATED_QA=true

# Optional: only required for OpenAI-backed agent/verifier paths.
OPENAI_API_KEY=

# PubMed MCP retrieval is the default evidence backend.
LITERATURE_RETRIEVAL_BACKEND=pubmed_mcp
PUBMED_MCP_PROJECT_PATH=../pubmed-clinical-mcp
# Optional. Defaults to the Python interpreter running WoundMind.
# PUBMED_MCP_PYTHON=/absolute/path/to/python
PUBMED_MCP_TIMEOUT_SECONDS=45
PUBMED_MCP_MAX_RESULTS=8

# Optional local overrides. Set LITERATURE_RETRIEVAL_BACKEND=local to use these.
CHROMA_DB_PATH=./chroma_db
CLINICAL_DOCS_PATH=./clinical_docs
CASE_ARTIFACTS_PATH=./case_artifacts
