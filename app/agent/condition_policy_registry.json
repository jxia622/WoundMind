{
  "version": "2026-06-28",
  "purpose": "Condition-gated tool and retrieval policy for the WoundMind agent.",
  "implemented_tool_ids": [
    "open_wound_segmentation",
    "relative_depth_map"
  ],
  "tools": {
    "open_wound_segmentation": {
      "implementation_status": "implemented",
      "runtime_tool": "segment_wound",
      "implementation": "Current U-Net++ open wound segmentation model.",
      "feature_outputs": [
        "mask_available",
        "mask_area_pixels",
        "mask_fraction",
        "open_wound_roi"
      ],
      "best_for_conditions": [
        "pressure_injury",
        "dfu",
        "vlu",
        "burn_wounds"
      ],
      "limitations": [
        "Designed for open wound masks, not closed rashes, pigment disorders, or lesion counting.",
        "Mask is not a tissue exposure classifier."
      ]
    },
    "relative_depth_map": {
      "implementation_status": "implemented",
      "runtime_tool": "depth_map",
      "implementation": "Depth Anything V2 relative depth map, optionally guided by the wound mask ROI.",
      "feature_outputs": [
        "relative_depth",
        "depth_preview",
        "roi"
      ],
      "best_for_conditions": [
        "pressure_injury",
        "dfu"
      ],
      "limitations": [
        "Provides relative visual depth, not calibrated physical depth.",
        "Cannot confirm exposed bone, undermining, tunneling, perfusion, infection, or osteomyelitis."
      ]
    },
    "tissue_exposure_classifier": {
      "implementation_status": "not_implemented",
      "runtime_tool": null,
      "limitations": [
        "Leave as a future model for visible fat, tendon, muscle, or bone exposure."
      ]
    },
    "necrosis_detector": {
      "implementation_status": "not_implemented",
      "runtime_tool": null,
      "limitations": [
        "Leave as a future tissue classifier for eschar or necrotic tissue."
      ]
    },
    "perfusion_proxy": {
      "implementation_status": "not_implemented",
      "runtime_tool": null,
      "limitations": [
        "RGB image alone cannot reliably confirm perfusion or ischemia."
      ]
    },
    "serial_area_change": {
      "implementation_status": "not_implemented",
      "runtime_tool": null,
      "limitations": [
        "Requires longitudinal image alignment and measurement history."
      ]
    },
    "exudate_detection": {
      "implementation_status": "not_implemented",
      "runtime_tool": null,
      "limitations": [
        "Leave as future drainage or moisture classifier."
      ]
    },
    "redness_estimator": {
      "implementation_status": "not_implemented",
      "runtime_tool": null,
      "limitations": [
        "Color and erythema cues may be present in the classifier network but are not exposed as a standalone calibrated tool."
